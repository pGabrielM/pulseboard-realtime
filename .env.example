# Postgres (docker compose up -d postgres)
DATABASE_URL="postgresql://pulseboard:pulseboard@localhost:5453/pulseboard"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Public URL of the app (used in share links)
NEXT_PUBLIC_APP_URL="http://localhost:3103"

# Shared secret for GET /api/cron/check (scheduler)
CRON_SECRET=""

# Timezone used to group daily uptime on status pages
APP_TIMEZONE="America/Sao_Paulo"

# Development only: allow monitoring localhost/private networks
# MONITOR_ALLOW_PRIVATE=true
